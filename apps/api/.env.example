# --- Application ---
APP_ENV=development
APP_NAME=OfferLater
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-random-64-character-secret
SESSION_TTL_MINUTES=480
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+psycopg://offerlater:offerlater_dev@localhost:5432/offerlater

# --- Cookies / CSRF ---
# Set true in production (HTTPS). SameSite is Lax; the web app proxies /api.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Storage (private, never served statically) ---
STORAGE_DIR=./storage

# --- Email (console = development, no real email sent) ---
EMAIL_PROVIDER=console
EMAIL_FROM=MR. ELECTRICAL WORKS <offers@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
RESEND_API_KEY=

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true

# --- Seed demo accounts (only used by `python -m app.seed`) ---
SEED_ADMIN_EMAIL=admin@mrelectricalworks.in
SEED_ADMIN_PASSWORD=OfferLater!2026
